# Copia a .env.local (en tu PC). En Easypanel, pon estas variables en la pestaña "Environment".

# ---------- Cuentas que se crean solas al desplegar ----------
# Al arrancar, la web crea estas cuentas si no existen. Cada contraseña se aplica UNA sola vez:
# si después se cambia desde el panel (Mi cuenta), reiniciar o volver a desplegar NO la pisa.
# Solo se vuelve a aplicar si cambias aquí el valor. Mínimo 10 caracteres.
# (El correo de ADMIN_EMAIL también queda como administrador si se registra desde el foro.)

# Administrador del cliente
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=
ADMIN_NAME=Equipo Tu Embalaje

# Soporte técnico (superadministrador): solo otro superadministrador puede modificar esta cuenta,
# y desde ella se puede restablecer la contraseña de cualquier administrador.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Soporte técnico

# Dominio público del sitio (sin "/" al final). Se usa en el sitemap, Google y vistas previas al compartir.
# En Docker/Easypanel debe estar también como "Build argument", porque se fija al compilar.
NEXT_PUBLIC_SITE_URL=https://tuembalaje.com

# Opcional: ruta del archivo SQLite (por defecto ./data/foro.db; en Docker ya es /app/data/foro.db)
# DATABASE_PATH=
